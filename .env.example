# Только локальная среда разработки. НЕ используйте это значение пароля на сервере.
POSTGRES_USER=copilot
POSTGRES_DB=copilot
POSTGRES_PASSWORD=replace_with_random_local_password

# Несекретные настройки FastAPI Backbone.
COPILOT_ENVIRONMENT=development
COPILOT_APP_NAME=AI Executive Co-pilot API
COPILOT_APP_VERSION=0.1.0
COPILOT_API_V1_PREFIX=/api/v1
