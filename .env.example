# Только локальная среда разработки. НЕ используйте это значение пароля на сервере.
POSTGRES_USER=copilot
POSTGRES_DB=copilot
POSTGRES_PASSWORD=replace_with_random_local_password

# Несекретные настройки FastAPI Backbone.
COPILOT_ENVIRONMENT=development
COPILOT_APP_NAME=AI Executive Co-pilot API
COPILOT_APP_VERSION=0.1.0
COPILOT_API_V1_PREFIX=/api/v1
COPILOT_DATABASE_URL=postgresql+asyncpg://copilot:replace_with_random_local_password@127.0.0.1:5432/copilot
COPILOT_DATABASE_CONNECT_TIMEOUT_SECONDS=3
COPILOT_USE_DEMO_REPOSITORY=false
COPILOT_SESSION_COOKIE_NAME=copilot_session
COPILOT_SESSION_COOKIE_SECURE=false
COPILOT_SESSION_TTL_MINUTES=480
COPILOT_DEMO_SEED_PASSWORD=

# GigaChat: заполните credentials только в локальном .env, не в Git.
COPILOT_GIGACHAT_CREDENTIALS=
COPILOT_GIGACHAT_SCOPE=GIGACHAT_API_PERS
COPILOT_GIGACHAT_MODEL=GigaChat-2
COPILOT_GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
COPILOT_GIGACHAT_CHAT_URL=https://api.giga.chat/v1/chat/completions
COPILOT_GIGACHAT_TEMPERATURE=0.1
COPILOT_GIGACHAT_TOP_P=1.0
COPILOT_GIGACHAT_MAX_TOKENS=1024
COPILOT_GIGACHAT_TIMEOUT_SECONDS=20
COPILOT_GIGACHAT_TOKEN_REFRESH_SKEW_SECONDS=30
